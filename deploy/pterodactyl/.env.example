# 666 Streaming — preset for a Pterodactyl Node.js 22 server.
# Copy this file to /home/container/.env; keep real secrets only on the server.
# SERVER_PORT is deliberately absent: use the primary allocation supplied by Wings.
# Hosting environment variables override this file. Leave PORT empty.
NODE_ENV=production
HOST=0.0.0.0
PORT=
PUBLIC_URL=
COOKIE_SECURE=false

# Empty creates data/initial-password (600), readable through your file manager.
# Or set a long private password here/on the panel. Never commit a real password.
APP_PASSWORD=
DATA_DIR=/home/container/data
MEDIA_DIR=

# These are OS executables, NOT npm packages. Both FFmpeg and FFprobe are required.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Empty uses bin/yt-dlp, unless the image already supplies YTDLP_PATH.
# Only an official standalone executable; it embeds CPython, no system Python/pip.
YTDLP_PATH=
VIDEO_ENCODER=libx264
FFMPEG_THREADS=1
STREAM_QUALITY=720p
MAX_STREAMS=1
MAX_CACHE_MB=512
MAX_UPLOAD_MB=256
MAX_DOWNLOAD_MB=512
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO

# Optional official application bot. Never use a Discord user-account token.
DISCORD_BOT_TOKEN=
ALLOWED_USER_IDS=
OPERATOR_USER_IDS=
DISCORD_GUILD_IDS=

# Optional external providers. No assumed localhost services.
JELLYFIN_URL=
JELLYFIN_API_KEY=
TVHEADEND_URL=
TVHEADEND_USER=
TVHEADEND_PASS=
