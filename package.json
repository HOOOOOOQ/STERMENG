{
  "name": "666-streaming",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "666 Streaming — Node.js HLS dashboard and official Discord audio companion",
  "license": "GPL-3.0-or-later",
  "author": "topsoil / dev-topsoil (original project)",
  "contributors": [
    "666 Streaming contributors (JavaScript migration)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HOOOOOOQ/STERMENG.git"
  },
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js --check",
    "check:source": "node scripts/check-source.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src scripts tests frontend/app.js eslint.config.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:all": "npm run check:source && npm run lint && npm run build && npm test && npm run test:browser",
    "install:ytdlp": "node scripts/install-ytdlp.mjs",
    "migrate:data": "node scripts/migrate-data.mjs",
    "archive": "node scripts/archive.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "busboy": "1.6.0",
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "hls.js": "1.7.4",
    "opusscript": "0.1.1",
    "saxes": "6.0.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sparticuz/chromium": "153.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright-core": "1.65.0"
  }
}
