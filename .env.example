# 666 Streaming — Node.js 22 / ES Modules. Copy to .env; do not commit secrets.
# Pterodactyl: PORT empty uses the panel's primary allocation SERVER_PORT.
HOST=0.0.0.0
PORT=
SERVER_PORT=8080
# Root HTTP(S) origin, e.g. https://media.your-domain.tld (no /path).
PUBLIC_URL=

# Shared trusted-operator password. Empty writes DATA_DIR/initial-password (600).
APP_PASSWORD=
# true behind HTTPS; false only for direct HTTP testing.
COOKIE_SECURE=false

# Relative to application directory, independent of shell working directory.
DATA_DIR=./data
MEDIA_DIR=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Standalone yt-dlp executable, NOT the Python zipapp. Empty defaults to bin/yt-dlp.
# Install explicitly with npm run install:ytdlp (GitHub release access required).
YTDLP_PATH=
VIDEO_ENCODER=libx264
FFMPEG_THREADS=2
# h264_vaapi only, host-admin-provided device/driver required:
VAAPI_DEVICE=/dev/dri/renderD128

STREAM_QUALITY=720p
STREAM_RESOLUTION=
STREAM_FPS=30
# 64k–100M, e.g. 3500k or 8M.
STREAM_VIDEO_BITRATE=3500k
# Positive advances audio; negative delays it. -5000..5000 ms.
STREAM_AV_SYNC_MS=0
MAX_STREAMS=3
STREAM_IDLE_SECONDS=900
MAX_CACHE_MB=1024
MAX_UPLOAD_MB=1024
MAX_DOWNLOAD_MB=1024
RESOLVE_TIMEOUT=300
# ? admits unknown source height; known >1080p excluded, output still capped.
YTDLP_FORMAT=bv*[height<=?1080]+ba/b[height<=?1080]
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO

# Optional OFFICIAL Discord application bot. No user-account tokens/selfbots.
# OAuth scopes: bot + applications.commands; intents: Guilds + GuildVoiceStates.
# Privileged Message Content / Members intents NOT required (slash controls).
DISCORD_BOT_TOKEN=
ALLOWED_USER_IDS=
OPERATOR_USER_IDS=
# Optional comma-separated development guild IDs for immediate slash registration.
# Empty registers global commands (Discord propagation delay can apply).
DISCORD_GUILD_IDS=

# Optional services; no localhost/default-server assumptions.
JELLYFIN_URL=
JELLYFIN_API_KEY=
TVHEADEND_URL=
TVHEADEND_USER=
TVHEADEND_PASS=
